# Копирайте този файл като .env (в главната папка на проекта) и попълнете стойностите.
# .env се чете автоматично при локално стартиране и НЕ се качва в GitHub.

# База данни
DB_URL=jdbc:postgresql://localhost:5432/langforu
DB_USERNAME=postgres
DB_PASSWORD=

# Имейли (локално може да е Gmail с App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=langforu.softdev@gmail.com

# Виртуален асистент Sevi (OpenAI или Gemini)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini

# Начални акаунти (създават се само ако паролата е попълнена)
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# Криптиране: ключ = произволен текст, сол = само 0-9 и a-f (напр. 16 символа)
ENCRYPTION_KEY=
ENCRYPTION_SALT=
